{
  "name": "@errand-agent/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "evals": "tsx src/evals/eval.cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
