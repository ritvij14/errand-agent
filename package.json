{
  "name": "errand-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm run test -w server && npm run evals -w server && npm run test -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "evals": "npm run evals -w server",
    "verify:up": "bash scripts/verify-up.sh",
    "verify:down": "bash scripts/verify-down.sh",
    "verify:reset": "bash scripts/verify-reset.sh"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "eslint": "^10.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
